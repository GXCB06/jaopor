# Copy to .env.local (local dev) and add the same vars in Vercel → Project → Settings → Environment Variables.
# Public values (safe in the browser bundle):
NEXT_PUBLIC_SUPABASE_URL=https://letfxefyqxxrfujpwtri.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Jz9ha-2sWCh7c8Ax0ZCWlA_lAWEKHxg
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Disabled unless set: there is no default.
# Analytics render in production only, never in dev/e2e. Leave empty to keep GA off.
NEXT_PUBLIC_GA_ID=

# Server-only secrets — never commit real values, never prefix with NEXT_PUBLIC_.
# Supabase dashboard → Project Settings → API Keys → secret key (sb_secret_…)
SUPABASE_SECRET_KEY=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Optional (GitHub build proof): a fine-grained token with NO permissions (public repos only).
# Raises GitHub's API limit from 60 to 5,000 requests/hour. github.com/settings/personal-access-tokens
GITHUB_TOKEN=
# Optional ("✨ fill from website" in the edit form): a FREE Google AI Studio key
# (aistudio.google.com/apikey). Without it the helper uses the page's own metadata, no AI.
# Free tier note: Google may use prompts to improve its products; only public website text is sent.
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash, free tier)
GEMINI_MODEL=
