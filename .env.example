# Copy to .env.local (local dev) and add the same vars in Vercel → Project → Settings → Environment Variables.
# Public values (safe in the browser bundle):
NEXT_PUBLIC_SUPABASE_URL=https://letfxefyqxxrfujpwtri.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Jz9ha-2sWCh7c8Ax0ZCWlA_lAWEKHxg
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4. On by default (JaoPor's property G-JYPJ2RFH4N) in production; dev/e2e never send hits.
# Set to another G-… id to override, or to "off" to disable. Leave unset to use the default.
# NEXT_PUBLIC_GA_ID=

# Server-only secrets — never commit real values, never prefix with NEXT_PUBLIC_.
# Supabase dashboard → Project Settings → API Keys → secret key (sb_secret_…)
SUPABASE_SECRET_KEY=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Optional (GitHub build proof): a fine-grained token with NO permissions (public repos only).
# Raises GitHub's API limit from 60 to 5,000 requests/hour. github.com/settings/personal-access-tokens
GITHUB_TOKEN=
# Optional ("✨ fill from website" in the edit form): a FREE Google AI Studio key
# (aistudio.google.com/apikey). Without it the helper uses the page's own metadata, no AI.
# Free tier note: Google may use prompts to improve its products; only public website text is sent.
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash, free tier)
GEMINI_MODEL=

# Optional (Google Analytics as a visitor source). One Google Cloud service account for JaoPor:
# enable "Google Analytics Data API" + "Google Analytics Admin API", create a JSON key, paste the
# whole JSON on ONE line below (server-only). Founders add the account's email as a Viewer on their
# GA4 property; tokens are minted with the analytics.readonly scope only. Both unset → GA4 hidden.
GA4_SERVICE_ACCOUNT_JSON=
# The same service account's email (public: founders copy it into GA4).
NEXT_PUBLIC_GA4_SERVICE_EMAIL=

# Optional (for-sale listings): moderator user ids, comma-separated (server-only). They can hide or
# restore a listing from its project page; unset means nobody can. Copy ids from Supabase Auth.
MODERATOR_USER_IDS=
